# Copy to .env and fill in. Required values have no default.

# --- Vault ---
BRAIN_VAULT="~/Documents/Obsidian/my-vault"   # required: your Obsidian vault root
# BRAIN_INVENTORY_DIR=inventory               # subfolder holding item notes
# BRAIN_MCP_AUTOCOMMIT=1                       # 0 to skip git commit/push on writes

# --- Transport ---
# BRAIN_MCP_TRANSPORT=stdio                    # stdio (local) or http (remote/phone)
# BRAIN_MCP_HOST=127.0.0.1
# BRAIN_MCP_PORT=8848

# --- HTTP mode (remote / Claude phone app) ---
# BRAIN_MCP_PUBLIC_URL=https://your-host.example.com   # required in http mode
# BRAIN_MCP_PASSWORD=change-me-to-something-strong      # required in http mode
# BRAIN_MCP_INSECURE=                          # 1 disables OAuth (loopback testing only)
# BRAIN_MCP_STATE=~/.config/brain-inventory-mcp/oauth.json
